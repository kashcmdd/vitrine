{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitrine",
  "version": "0.1.0",
  "identifier": "app.vitrine.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vitrine",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": null,
        "backgroundColor": "#F6F1E8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/games/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "A private collection of games.",
    "longDescription": "Vitrine is a desktop game launcher for PC games and emulated systems. Cases rest on a shelf as spines; pull one out to see its face.",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://homelab-vps.taild1c05c.ts.net/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
